		{"id":"5fd77e5d5c37cc32","type":"text","text":"Dedektif morgdan/mezardan cesedi çıkarıp ricin testi yaptırıyor","x":-1300,"y":403,"width":191,"height":146},
		{"id":"7ebec2c82754c5b2","type":"text","text":"","x":-7193,"y":2178,"width":50,"height":50},
		{"id":"ccd54d24415bac8e","type":"text","text":"","x":-7683,"y":2128,"width":50,"height":50},
