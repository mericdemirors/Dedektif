		{"id":"087408af8038e8e6","type":"text","text":"# DAY17 END","x":-3092,"y":-6526,"width":231,"height":236},
		{"id":"4c9f7d4ec7e1a4eb","type":"text","text":"Sinabung'da 66 saat, üniversiteye tüp gönder","x":-2959,"y":-6261,"width":191,"height":146},
		{"id":"b4dddd31f1113aac","type":"text","text":"# 12NİSAN","x":-2768,"y":-6458,"width":231,"height":50},
		{"id":"ce0153e137eb5d0b","type":"text","text":"Merapi dağına gidiyor","x":-2359,"y":-6261,"width":191,"height":146},
		{"id":"975c533a128b578e","type":"text","text":"Erta Ale'ye gidiyor","x":-1762,"y":-6070,"width":191,"height":146},
		{"id":"1035ace47af90637","type":"text","text":"Annesi ölünce burs kazanıyor, RBA'nın yanına gitmek istiyor","x":-3553,"y":-6070,"width":191,"height":146},
		{"id":"ab55343cd03ecef7","type":"text","text":"Kargoyla kum tüpü alınca Asmara International Airport'a gidiyor","x":-3187,"y":-6070,"width":191,"height":146},
		{"id":"3b82fe8384a5b013","type":"text","text":"Motor kiralayıp Dalol'a bakıyor orada geceliyor","x":-2359,"y":-6070,"width":191,"height":146},
		{"id":"86e2c1a3064fca3a","type":"text","text":"# DAY16 END","x":-3689,"y":-6526,"width":231,"height":236},
		{"id":"c3498928ad108ad7","type":"text","text":"# DAY15 END","x":-4286,"y":-6526,"width":231,"height":236},
		{"id":"9ae7d9eeda526608","type":"text","text":"# 10NİSAN","x":-3962,"y":-6459,"width":231,"height":50},
		{"id":"42bd0dac5880c62e","type":"text","text":"Sinabung'da 66 saat","x":-4141,"y":-6261,"width":191,"height":146},
		{"id":"65fc01c880f8e92f","type":"text","text":"Sinabung'da 66 saat","x":-3553,"y":-6261,"width":191,"height":146},
		{"id":"ffc147ffafcc0e03","type":"text","text":"Olay dedektifin kulağına gitmeyince rus daha yakınlarını öldürmek istiyor, diğer zehirleri üretmek için sipariş veriyor","x":-4142,"y":-4471,"width":191,"height":146},
		{"id":"0d5e66ff8a5c827a","type":"text","text":"Bekçi bunu ölü bulmuş polisi aramış","x":-4699,"y":-4471,"width":191,"height":146},
		{"id":"e0187b17fcffd2c3","type":"text","text":"Doktor tanıyı koyup adamı morga kaldırmış","x":-4493,"y":-4471,"width":191,"height":146},
		{"id":"2d6e7481d129d1c3","type":"text","text":"Rus ajan castor bean'den zehri hazır eder.","x":-5365,"y":-4617,"width":191,"height":146},
		{"id":"c6042a86d35e7cd4","type":"text","text":"parkta rastgele bulduğu gazete okuyan elemanın birine enjekte eder","x":-5173,"y":-4616,"width":191,"height":146},
		{"id":"91e3400297c9f3cf","type":"text","text":"Eleman öğlene doğru hastalanır","x":-5364,"y":-4473,"width":191,"height":146},
		{"id":"688e602d4d057d4b","type":"text","text":"Eleman kusmaya başlayıp bi yere sızıp ölmüş","x":-5174,"y":-4470,"width":191,"height":146},
		{"id":"989501e17ea8fcf6","type":"text","text":"Rus ajan gazeteyi görüp \"çoktan 1/3'ünü bitirmişler demek, ucu ucuna yetişecek gibi\" diyor","x":-4982,"y":-4615,"width":191,"height":146},
		{"id":"245783ea6d967432","type":"text","text":"# DAY14 END","x":-4883,"y":-6526,"width":231,"height":236},
		{"id":"e4633b25df6fdf94","type":"text","text":"Sinabung'da 66 saat","x":-4747,"y":-6261,"width":191,"height":146},
		{"id":"25679d4553e2705e","type":"text","text":"# 9NİSAN","x":-4559,"y":-6458,"width":231,"height":50},
		{"id":"86c7a8cbee557c8b","type":"text","text":"Sinabung dağına gidiyor","x":-5323,"y":-6261,"width":191,"height":146},
		{"id":"971701d655d73420","type":"text","text":"# DAY13 END","x":-5480,"y":-6526,"width":231,"height":236},
		{"id":"4ac6814da16650c9","type":"text","text":"Dedektif rus ajanın evini arayıp diğer zehri falan da buluyor","x":805,"y":-3380,"width":191,"height":146},
		{"id":"60c4b6009fcf1d41","type":"text","text":"ricin ölümü bulunduktan sonra rus ajan göz altına alınıyor","x":592,"y":-3380,"width":191,"height":146},
		{"id":"d8e6ba123e261280","type":"text","text":"Yazara zehir testi yapılıyor, olayı çözmek için şeker kabuğuna tamirci cesedine çocuğuna test yapıyor","x":596,"y":-3554,"width":191,"height":146},
		{"id":"96608df06a150f3d","type":"text","text":"Antifriz olayını çözüyor ve rusun evine gidiyor","x":796,"y":-3554,"width":191,"height":146},
		{"id":"4d15e416508eb89b","type":"text","text":"Kadın da \"şüpheli sadece rus kadınla araba tamir etti\" diyor","x":778,"y":-3922,"width":191,"height":146},
		{"id":"e674315c20fa13aa","type":"text","text":"Polis dedektife gidiyor, dedektifle tamircinin karısına gidiyorlar, kocan öldü diyorlar","x":587,"y":-3922,"width":191,"height":146},
		{"id":"67c57affbc5ff506","type":"text","text":"Tamirci ve çocuğu eve dönünce karısı adamı evden kovuyor","x":383,"y":-3922,"width":191,"height":146},
		{"id":"1d253433e147a60b","type":"text","text":"Polis tamircinin karısına gidip soru soruyorlar, sonra barları sorguluyorlar","x":383,"y":-3700,"width":191,"height":146},
		{"id":"b46bdc59051c7609","type":"text","text":"Tekrar tamircinin evine gidip şeker kabuğunu öğreniyorlar","x":596,"y":-3741,"width":191,"height":146},
		{"id":"b3014fc2ffc7f6e0","type":"text","text":"Bekçi tamirciyi buluyor ve polise haber veriyor","x":183,"y":-3700,"width":191,"height":146},
		{"id":"5c3267052f3ee128","type":"text","text":"Tamirci önce bara gidiyor, sonra parka gidiyor ve orada ölüyor","x":-17,"y":-3700,"width":191,"height":146},
		{"id":"88bea7842dbaa651","type":"text","text":"Polis çözemiyor, doktor da mantıklı bir sebep bulamıyor, sabah dedektife gidelim diyorlar","x":-17,"y":-3554,"width":191,"height":146},
		{"id":"9e750087e68a0492","type":"text","text":"Dedektif ofisine geri dönüyor ve yazarın temizlikçisini görüyor","x":796,"y":-3741,"width":191,"height":146},
		{"id":"9cb79ded368161c4","type":"text","text":"Öğlen temizlikçi kadın ölüsünü buluyor ve dedektife gidiyor","x":987,"y":-4212,"width":191,"height":146},
		{"id":"94dfa0803348f9f0","type":"text","text":"Yazar hasta olur, uyuyunca geçer diye uyur","x":365,"y":-4212,"width":191,"height":146},
		{"id":"4c04e7857be7923e","type":"text","text":"Uyanınca konuşamadığını ve kollarını oynatamadığını farkeder","x":587,"y":-4212,"width":191,"height":146},
		{"id":"9d01584f076771ea","type":"text","text":"Dedektif rus ajanı yakalıyor ve evinde ricin yapma aletleri bulunuyor","x":611,"y":-4466,"width":191,"height":146},
		{"id":"a4dceff6c54b01a0","type":"text","text":"Yazarın evine gidiyorlar, komodinin oradaki yazıyı buluyor","x":1002,"y":-3741,"width":191,"height":146},
		{"id":"5fd77e5d5c37cc32","type":"text","text":"Dedektif morgdan/mezardan cesedi çıkarıp ricin testi yaptırıyor","x":811,"y":-4466,"width":191,"height":146},
		{"id":"469d0e26c023ada7","type":"text","text":"Kendini yatakta yerde sürüyerek masaya sonrada komodine gider","x":787,"y":-4212,"width":191,"height":146},
		{"id":"45d57d23091ca009","type":"text","text":"Rus kadının dairesine çıkıyorlar, kadının evini inceliyorlar","x":987,"y":-3922,"width":191,"height":146},
		{"id":"2fb09be9059d3e2a","type":"text","text":"ricin ölümünü bulmak için doktorla konuşuyorlar, adamın yanında ne varsa hepsine bakmak istiyoruz diyorlar. Ölü adamın elinde uzay haberli gazeteyi görünce dedektifle yardımcısı yine uzay üzerine konuşuyor.","x":996,"y":-3554,"width":191,"height":146},
		{"id":"174f5a315f52bbbb","type":"text","text":"Gazetede yazan araştırmanın 2/3'ü bitti haberini görüyorlar, dedektifle yardımcısı bunun üzerine konuşuyor.","x":1213,"y":-3208,"width":191,"height":146},
		{"id":"1d0bd80c31f06305","type":"text","text":"Komşu gelip kadını görüyor ve bıçağı çıkarıyor","x":-8349,"y":-5113,"width":191,"height":146},
		{"id":"23242e719f56c7e6","type":"text","text":"Rus ajan tamir yardımı için apartman tamircisini çağırıyor","x":-17,"y":-3922,"width":191,"height":146},
		{"id":"e9cbb999ebe2af52","type":"text","text":"Araba tamir olunca limonata ikram ediyor, sonra gidip kusuyor şeker yiyor","x":183,"y":-3922,"width":191,"height":146},
		{"id":"528e99aa841beaa3","type":"text","text":"Rus ajan evde bakteriden zehri üretir ve yemek yapak, kılık değiştirir","x":-17,"y":-4212,"width":191,"height":146},
		{"id":"caa850b39644bf0d","type":"text","text":"Diğer zehirler de hazır oluyor","x":-579,"y":-4212,"width":191,"height":146},
		{"id":"e8aaa14b24c64236","type":"text","text":"Öğlen yazarın dairesine gider, yemek yerler sonra ayrılır","x":174,"y":-4212,"width":191,"height":146},
		{"id":"4acb817e7f3bf3da","type":"text","text":"Rus ajanı sorguya alıyorlar, ve her şeyi itiraf ediyor","x":1418,"y":-3207,"width":191,"height":146},
		{"id":"ce28b92a5668ea82","type":"text","text":"Patates soyuyorlar, dedektif patates olayını ve sağlak solaklığı yorumluyor","x":-8349,"y":-4967,"width":191,"height":146},
		{"id":"203ab2c19d58d87e","type":"text","text":"Dedektif olayı çözüyor ama polisi ve tamirciyi çağırıp bekliyorlar","x":-8149,"y":-5113,"width":191,"height":146},
		{"id":"b71a35777497a0b2","type":"text","text":"Tamirciyi ve polisi beklerlerken komşuya ve yardımcısına kimlerin suçlu olamayacağını anlatıyor","x":-7949,"y":-5113,"width":191,"height":146},
		{"id":"e0b858c7635608b9","type":"text","text":"Rus'un evine gidiyorlar topluca, araba kataloglarını görüyor","x":-8149,"y":-4967,"width":191,"height":146},
		{"id":"ad25f2d31d5f7f9a","type":"text","text":"Tamircinin oğlu ve kendisi kurabiye alıyor sessizce","x":-8158,"y":-5405,"width":191,"height":146},
		{"id":"5226c3e5bccdf463","type":"text","text":"Çocuklar dedektifin yanında geçiyor yukarı çıkınca bağırıyorlar","x":-8158,"y":-5259,"width":191,"height":146},
		{"id":"85011f2734e1a79a","type":"text","text":"Dedektif apartman girişinde tamirciyle karşılaşıyor","x":-7958,"y":-5405,"width":191,"height":146},
		{"id":"0a24de4b709b6a07","type":"text","text":"Dedektif yukarı koşuyor kadın ölü bulunuyor","x":-7958,"y":-5259,"width":191,"height":146},
		{"id":"044436015772fdb2","type":"text","text":"Dedektif bi ara kadının oğluna ulaşmaya çalışıyor RBA'nın üniversitesini arayıp","x":-7699,"y":-5405,"width":195,"height":146},
		{"id":"a7fcdeed71672aeb","type":"text","text":"Rus ajan cenazede asistanı bekliyor ama bilgi alamayınca, dedektif de asistanla konuşmaya çalışınca ve olaya karışınca onu diğer ölümleri de yapmak için zehir hazırlamaya başlıyor, malzemeleri sipariş ediyor falan.","x":-7473,"y":-5405,"width":191,"height":146},
		{"id":"c69cb9b96013164f","type":"text","text":"# DAY12 END","x":-6077,"y":-6526,"width":231,"height":236},
		{"id":"0e446974e47fb05f","type":"text","text":"Erta Ale'de 66 saat, üniversiteye tüp gönder","x":-5926,"y":-6261,"width":191,"height":146},
		{"id":"e1907b57fea447e0","type":"text","text":"# DAY10 END","x":-7271,"y":-6526,"width":231,"height":236},
		{"id":"f7d993f603eaa46b","type":"text","text":"# DAY11 END","x":-6674,"y":-6526,"width":231,"height":236},
		{"id":"c2dd4d68a579299e","type":"text","text":"Erta Ale'de 66 saat","x":-6536,"y":-6261,"width":191,"height":146},
		{"id":"ca92cb2280ea0430","type":"text","text":"Dedektif intiharın nasıl olduğunu anlatıyor, herkes dağılıyor","x":-7949,"y":-4967,"width":191,"height":146},
		{"id":"2896256385cefdd9","type":"text","text":"Erta Ale'de 66 saat","x":-7112,"y":-6261,"width":191,"height":146},
