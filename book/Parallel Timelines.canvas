		{"id":"91e3400297c9f3cf","type":"text","text":"Eleman öğlene doğru hastalanır","x":-6587,"y":411,"width":191,"height":146},
		{"id":"c6042a86d35e7cd4","type":"text","text":"parkta rastgele bulduğu elemanın birine enjekte eder","x":-6787,"y":411,"width":191,"height":146},
		{"id":"b71a35777497a0b2","type":"text","text":"Tamirciyi ve polisi beklerlerken komşuya ve yardımcısına kimlerin suçlu olamayacağını anlatıyor","x":-8446,"y":-62,"width":191,"height":146},
		{"id":"ce28b92a5668ea82","type":"text","text":"Patates soyuyorlar, dedektif patates olayını ve sağlak solaklığı yorumluyor","x":-8246,"y":-62,"width":191,"height":146},
		{"id":"044436015772fdb2","type":"text","text":"Dedektif bi ara kadının oğluna ulaşmaya çalışıyor RBA'nın üniversitesini arayıp","x":-7606,"y":-62,"width":195,"height":146},
		{"id":"a7fcdeed71672aeb","type":"text","text":"Rus ajan cenazede asistanı bekliyor ama bilgi alamayınca diğerlerini öldürmeye başlıyor. Dedektif de asistanla konuşmata çalışınca ve olaya karışınca onu öldürmek istiyor","x":-7380,"y":-62,"width":191,"height":146},
		{"id":"e0b858c7635608b9","type":"text","text":"Rus'un evine gidiyorlar topluca, araba kataloglarını görüyor","x":-8046,"y":-62,"width":191,"height":146},
		{"id":"ca92cb2280ea0430","type":"text","text":"Dedektif intiharın nasıl olduğunu anlatıyor, herkes dağılıyor","x":-7846,"y":-62,"width":191,"height":146},
		{"id":"203ab2c19d58d87e","type":"text","text":"Dedektif olayı çözüyor ama polisi ve tamirciyi çağırıp bekliyorlar","x":-8646,"y":-62,"width":191,"height":146},
		{"id":"e21dfbcc1ead24dd","type":"text","text":"Kadın bıçağı kendine saplıyor","x":-9446,"y":-62,"width":191,"height":146},
		{"id":"5226c3e5bccdf463","type":"text","text":"Çocuklar dedektifin yanında geçiyor yukarı çıkınca bağırıyorlar","x":-9246,"y":-62,"width":191,"height":146},
		{"id":"0a24de4b709b6a07","type":"text","text":"Dedektif yukarı koşuyor kadın ölü bulunuyor","x":-9046,"y":-62,"width":191,"height":146},
		{"id":"1d0bd80c31f06305","type":"text","text":"Komşu gelip kadını görüyor ve bıçağı çıkarıyor","x":-8846,"y":-62,"width":191,"height":146},
		{"id":"80301e3e6e0475ff","type":"text","text":"# DAYX END","x":-7750,"y":-682,"width":225,"height":85},
		{"id":"b57fcf69b37913f0","type":"text","text":"Tamirci dolapları tamir etmeye başlıyor","x":-10046,"y":-62,"width":191,"height":146},
		{"id":"ad25f2d31d5f7f9a","type":"text","text":"Tamircinin oğlu ve kendisi kurabiye alıyor sessizce","x":-9846,"y":-62,"width":191,"height":146},
		{"id":"85011f2734e1a79a","type":"text","text":"Dedektif apartman girişinde tamirciyle karşılaşıyor","x":-9646,"y":-62,"width":191,"height":146},
		{"id":"f3eed2569e0ce95e","type":"text","text":"Dalol'da 100 saat, üniversiteye tüp gönder","x":202,"y":-991,"width":191,"height":146},
