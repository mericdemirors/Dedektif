		{"id":"ff53b6803da713b2","type":"text","text":"BURADA ZEHİR ALIŞVERİŞİ VE HAZIRLIĞI  İÇİN YETERLİ ZAMAN GEÇMELİ","x":-5200,"y":-562,"width":235,"height":133},
		{"id":"1bad71ff7181098a","type":"text","text":"RBA cruise ship'de","x":-540,"y":-991,"width":191,"height":146},
