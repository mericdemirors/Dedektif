		{"id":"45f6e11efa3f62a9","type":"group","x":-840,"y":-400,"width":2620,"height":186,"label":"Side Case 1"},
		{"id":"688e602d4d057d4b","type":"text","text":"Eleman kusmaya başlayıp bi yere sızıp ölmüş","x":189,"y":100,"width":191,"height":146},
		{"id":"23242e719f56c7e6","type":"text","text":"Rus ajan tamir yardımı için apartman tamircisini çağırıyor","x":139,"y":580,"width":191,"height":146},
		{"id":"e9cbb999ebe2af52","type":"text","text":"Araba tamir olunca limonata ikram ediyor, sonra gidip kusuyor şeker yiyor","x":339,"y":580,"width":191,"height":146},
		{"id":"60c4b6009fcf1d41","type":"text","text":"ricin ölümü bulunduktan sonra rus ajan göz altına alınıyor","x":3522,"y":580,"width":191,"height":146},
		{"id":"4ac6814da16650c9","type":"text","text":"Dedektif rus ajanın evini arayıp diğer zehri falan da buluyor","x":3735,"y":580,"width":191,"height":146},
		{"id":"5fd77e5d5c37cc32","type":"text","text":"Dedektif morgdan/mezardan cesedi çıkarıp ricin testi yaptırıyor","x":3315,"y":100,"width":191,"height":146},
		{"id":"2fb09be9059d3e2a","type":"text","text":"ricin ölümünü bulmak için doktorla konuşuyorlar","x":3315,"y":580,"width":191,"height":146},
		{"id":"4acb817e7f3bf3da","type":"text","text":"Rus ajanı sorguya alıyorlar, ve her şeyi itiraf ediyor","x":3980,"y":820,"width":191,"height":146},
		{"id":"33cfda818b507a0a","type":"text","text":"Dedektif geçmişte bir şey bulamıyor ve günlüğü çalmaya karar veriyor","x":180,"y":-380,"width":191,"height":146},
		{"id":"2b404444eb758ee4","type":"text","text":"Dedektifin romandan haberi olması","x":-540,"y":-380,"width":191,"height":146},
		{"id":"99fff586086c381d","type":"text","text":"Romanı okuyup romanda bir terslik olduğunu anlaması","x":-340,"y":-380,"width":191,"height":146},
		{"id":"0f11acea32b01567","type":"text","text":"Dalol Dağına gidiyor","x":-244,"y":-620,"width":191,"height":146},
		{"id":"1bad71ff7181098a","type":"text","text":"RBA cruise ship'de","x":-540,"y":-620,"width":191,"height":146},
		{"id":"7ad185f03fa960aa","type":"text","text":"Dedektifin roman yazarını bulup onunla konuşması","x":-20,"y":-380,"width":191,"height":146},
		{"id":"f3eed2569e0ce95e","type":"text","text":"Dalol'da 100 saat","x":-40,"y":-620,"width":191,"height":146},
		{"id":"0d5e66ff8a5c827a","type":"text","text":"Bekçi bunu ölü bulmuş polisi aramış","x":514,"y":100,"width":191,"height":146},
		{"id":"469d0e26c023ada7","type":"text","text":"Kendini yatakta yerde sürüyerek masaya sonrada komodine gider","x":2300,"y":340,"width":191,"height":146},
		{"id":"4d15e416508eb89b","type":"text","text":"Kadın da \"şüpheli sadece rus kadınla araba tamir etti\" diyor","x":1895,"y":580,"width":191,"height":146},
		{"id":"5fa083a950fe300b","type":"text","text":"Erta Ale'ye gidiyor","x":323,"y":-620,"width":191,"height":146},
		{"id":"b57fcf69b37913f0","type":"text","text":"Tamirci dolapları tamir etmeye başlıyor","x":1365,"y":-140,"width":191,"height":146},
		{"id":"ad25f2d31d5f7f9a","type":"text","text":"Tamircinin oğlu ve kendisi kurabiye alıyor sessizce","x":1565,"y":-140,"width":191,"height":146},
		{"id":"85011f2734e1a79a","type":"text","text":"Dedektif apartman girişinde tamirciyle karşılaşıyor","x":1765,"y":-140,"width":191,"height":146},
		{"id":"91e3400297c9f3cf","type":"text","text":"Eleman öğlene doğru hastalanır","x":-11,"y":100,"width":191,"height":146},
		{"id":"c6042a86d35e7cd4","type":"text","text":"parkta rastgele bulduğu elemanın birine enjekte eder","x":-211,"y":100,"width":191,"height":146},
		{"id":"eae952db65f0c59d","type":"text","text":"Rus ajan castor bean'dan zehir üretir","x":-540,"y":100,"width":191,"height":146},
		{"id":"1035ace47af90637","type":"text","text":"Annesi ölünce burs kazanıyor, RBA'nın yanına gitmek istiyor","x":440,"y":-840,"width":191,"height":146},
		{"id":"5226c3e5bccdf463","type":"text","text":"Çocuklar dedektifin yanında geçiyor yukarı çıkınca bağırıyorlar","x":2165,"y":-140,"width":191,"height":146},
		{"id":"e21dfbcc1ead24dd","type":"text","text":"Kadın bıçağı kendine saplıyor","x":1965,"y":-140,"width":191,"height":146},
		{"id":"778191f7593b4ff3","type":"text","text":"Gece yazarın evine gizlice girip günlüğün fotolarını çekiyor","x":380,"y":-380,"width":191,"height":146},
		{"id":"510b1aa43ad3506b","type":"text","text":"Sadece USA uzayla ilgileniyor haberlerini biliyor","x":-539,"y":-1060,"width":191,"height":146},
		{"id":"e0b858c7635608b9","type":"text","text":"Rus'un evine gidiyorlar topluca, araba kataloglarını görüyor","x":3365,"y":-140,"width":191,"height":146},
		{"id":"0a24de4b709b6a07","type":"text","text":"Dedektif yukarı koşuyor kadın ölü bulunuyor","x":2365,"y":-140,"width":191,"height":146},
		{"id":"1d0bd80c31f06305","type":"text","text":"Komşu gelip kadını görüyor ve bıçağı çıkarıyor","x":2565,"y":-140,"width":191,"height":146},
		{"id":"203ab2c19d58d87e","type":"text","text":"Dedektif olayı çözüyor ama polisi ve tamirciyi çağırıp bekliyorlar","x":2765,"y":-140,"width":191,"height":146},
		{"id":"ca92cb2280ea0430","type":"text","text":"Dedektif intiharın nasıl olduğunu anlatıyor, herkes dağılıyor","x":3565,"y":-140,"width":191,"height":146},
		{"id":"31a57e4cf7938ee9","type":"text","text":"Merapi dağını gezip bi plan yapıyor sonraki yer neresi olabilir diye","x":2080,"y":-840,"width":191,"height":146},
		{"id":"c0a8e0751efaedfe","type":"text","text":"Bi balıkçı botuyla Mount Lamington'a gidiyor ve orada geceliyor","x":2280,"y":-840,"width":191,"height":146},
		{"id":"b71a35777497a0b2","type":"text","text":"Tamirciyi ve polisi beklerlerken komşuya ve yardımcısına kimlerin suçlu olamayacağını anlatıyor","x":2965,"y":-140,"width":191,"height":146},
		{"id":"ce28b92a5668ea82","type":"text","text":"Patates soyuyorlar, dedektif patates olayını ve sağlak solaklığı yorumluyor","x":3165,"y":-140,"width":191,"height":146},
		{"id":"d124d4b21b240c1c","type":"text","text":"Yogyakarta International Airport'a iniyor","x":1880,"y":-840,"width":191,"height":146},
		{"id":"c51ab49fa8e99dff","type":"text","text":"Yeni mesaj geliyor Merapi tüpüyle alakalı, sonra Sinanbung dağına gidip geceliyor","x":1500,"y":-840,"width":191,"height":146},
		{"id":"265c5774861c510c","type":"text","text":"Port Moresby'ye dönüyor ve RBA'nın botçusuna denk geliyor","x":2580,"y":-840,"width":191,"height":146},
		{"id":"975c533a128b578e","type":"text","text":"Erta Ale'ye gidiyor, yeni mesaj geliyor Sİnanburg tüpüyle ilgili","x":1091,"y":-840,"width":191,"height":146},
		{"id":"4fe0e345be7b4790","type":"text","text":"RBA yürüyerek Tavurvur'a gidiyor ama vadide kabileye yakalanıyor","x":2540,"y":-620,"width":191,"height":146},
		{"id":"d847d4db1542bcdd","type":"text","text":"RBA ve kabile birlikte Tavurvur'da 100 saat, sonra kabile RBA'yı esir alıyor","x":2740,"y":-620,"width":191,"height":146},
		{"id":"071349a46994be2d","type":"text","text":"Kualanamu International Airport'a uçuyor","x":1300,"y":-840,"width":191,"height":146},
		{"id":"69a4762e8f189fa0","type":"text","text":"Ulawun'da 100 saat","x":2226,"y":-620,"width":191,"height":146},
		{"id":"4c9f7d4ec7e1a4eb","type":"text","text":"Sinabung'da 100 saat","x":1102,"y":-620,"width":191,"height":146},
		{"id":"3148af320b482732","type":"text","text":"Kızın tezi dikkatini çekti diye apartmana tezi incelemeye gidiyor","x":1565,"y":-380,"width":191,"height":146},
		{"id":"24d3ce347a429d1f","type":"text","text":"Yazara gidip olayı açıklıyor","x":1365,"y":-380,"width":191,"height":146},
		{"id":"45d57d23091ca009","type":"text","text":"Rus kadının dairesine çıkıyorlar, kadının evini inceliyorlar","x":2095,"y":580,"width":191,"height":146},
		{"id":"9d01584f076771ea","type":"text","text":"Dedektif rus ajanı yakalıyor ve evinde ricin yapma aletleri bulunuyor","x":3115,"y":100,"width":191,"height":146},
		{"id":"d8e6ba123e261280","type":"text","text":"Yazara zehir testi yapılıyor, olayı çözmek için şeker kabuğuna tamirci cesedine çocuğuna test yapıyor","x":2915,"y":580,"width":191,"height":146},
		{"id":"9cb79ded368161c4","type":"text","text":"Öğlen temizlikçi kadın ölüsünü buluyor ve dedektife gidiyor","x":2500,"y":340,"width":191,"height":146},
		{"id":"b46bdc59051c7609","type":"text","text":"Tekrar tamircinin evine gidip şeker kabuğunu öğreniyorlar","x":2300,"y":580,"width":191,"height":146},
		{"id":"9e750087e68a0492","type":"text","text":"Dedektif ofisine geri dönüyor ve yazarın temizlikçisini görüyor","x":2500,"y":580,"width":191,"height":146},
		{"id":"a4dceff6c54b01a0","type":"text","text":"Yazarın evine gidiyorlar, komodinin oradaki yazıyı buluyor","x":2706,"y":580,"width":191,"height":146},
		{"id":"4c04e7857be7923e","type":"text","text":"Uyanınca konuşamadığını ve kollarını oynatamadığını farkeder","x":2100,"y":340,"width":191,"height":146},
		{"id":"3b82fe8384a5b013","type":"text","text":"Motor kiralayıp Dalol'a bakıyor orada geceliyor","x":840,"y":-840,"width":191,"height":146},
		{"id":"ce0153e137eb5d0b","type":"text","text":"Botla Merapi dağına gidiyor","x":1461,"y":-620,"width":191,"height":146},
		{"id":"3d93688f71daf970","type":"text","text":"Merapi'de 100 saat","x":1667,"y":-620,"width":191,"height":146},
		{"id":"dc6a5e929ea68a34","type":"text","text":"Botla Ulawun dağına gidiyor, sonra bot Port Moresby'ye geri dönüyor","x":2020,"y":-620,"width":191,"height":146},
		{"id":"94dfa0803348f9f0","type":"text","text":"Yazar hasta olur, uyuyunca geçer diye uyur","x":1780,"y":340,"width":191,"height":146},
		{"id":"96608df06a150f3d","type":"text","text":"Antifriz olayını çözüyor ve rusun evine gidiyor","x":3115,"y":580,"width":191,"height":146},
		{"id":"528e99aa841beaa3","type":"text","text":"Rus ajan evde bakteriden zehri üretir ve yemek yapak, kılık değiştirir","x":1374,"y":340,"width":191,"height":146},
		{"id":"e674315c20fa13aa","type":"text","text":"Polis dedektife gidiyor, dedektifle tamircinin karısına gidiyorlar, kocan öldü diyorlar","x":1695,"y":580,"width":191,"height":146},
		{"id":"e8aaa14b24c64236","type":"text","text":"Öğlen yazarın dairesine gider, yemek yerler sonra ayrılır","x":1574,"y":340,"width":191,"height":146},
		{"id":"88bea7842dbaa651","type":"text","text":"Polis çözemiyor, doktor da mantıklı bir sebep bulamıyor, sabah dedektife gidelim diyorlar","x":1339,"y":580,"width":191,"height":146},
		{"id":"ab55343cd03ecef7","type":"text","text":"Kargoyla kum tüpü alınca Asmara International Airport'a gidiyor","x":640,"y":-840,"width":191,"height":146},
		{"id":"03894e491a22926f","type":"text","text":"Erta Ale'de 100 saat","x":529,"y":-620,"width":191,"height":146},
		{"id":"86c7a8cbee557c8b","type":"text","text":"Botla Sinabung dağına gidiyor","x":896,"y":-620,"width":191,"height":146},
		{"id":"80c0a232592d9da0","type":"text","text":"Bütün gün günlüğün kopyasını çıkarıyor","x":705,"y":-380,"width":191,"height":146},
		{"id":"e0187b17fcffd2c3","type":"text","text":"Doktor tanıyı koyup adamı morga kaldırmış","x":720,"y":100,"width":191,"height":146},
		{"id":"ffc147ffafcc0e03","type":"text","text":"Olay dedektifin kulağına gitmeyince rus daha yakınlarını öldürmek istiyor","x":1034,"y":100,"width":191,"height":146},
		{"id":"67c57affbc5ff506","type":"text","text":"Tamirci ve çocuğu eve dönünce karısı adamı evden kovuyor","x":539,"y":580,"width":191,"height":146},
		{"id":"5c3267052f3ee128","type":"text","text":"Tamirci önce bara gidiyor, sonra parka gidiyor ve orada ölüyor","x":739,"y":580,"width":191,"height":146},
		{"id":"b3014fc2ffc7f6e0","type":"text","text":"Bekçi tamirciyi buluyor ve polise haber veriyor","x":939,"y":580,"width":191,"height":146},
		{"id":"1d253433e147a60b","type":"text","text":"Polis tamircinin karısına gidip soru soruyorlar, sonra barları sorguluyorlar","x":1139,"y":580,"width":191,"height":146},
		{"id":"718795a911f19562","type":"text","text":"Şifreleri çözüyor ve olayı anlıyor","x":1034,"y":-380,"width":191,"height":146},
		{"id":"044436015772fdb2","type":"text","text":"Dedektif bi ara kadının oğluna ulaşmaya çalışıyor RBA'nın üniversitesini arayıp","x":3805,"y":-140,"width":191,"height":146},
		{"id":"6e5047ccb64e17ed","type":"text","text":"Kızın tezini de bi ara okusun","x":4012,"y":-140,"width":191,"height":146},
		{"id":"a7fcdeed71672aeb","type":"text","text":"Rus ajan cenazede asistanı bekliyor ama bilgi alamayınca diğerlerini öldürmeye başlıyor. Dedektif de asistanla konuşmata çalışınca ve olaya karışınca onu öldürmek istiyor","x":4219,"y":-140,"width":191,"height":146},
		{"id":"47dac1c42f98f3d2","type":"text","text":"Rusya gelip kabileyi öldürüyor, RBA onları oyalamak için bahane üretiyor","x":3012,"y":-620,"width":191,"height":146},
		{"id":"a3ff94bea21fdfcc","type":"text","text":"Tavurvur'a gidince malzemelerini alıp kamp yapmaya gidiyor, kabileyi öldüren rusları görüyor","x":3220,"y":-840,"width":191,"height":146},
		{"id":"cbc07437296fd9d7","type":"text","text":"Ruslar birini duyunca aramaya çıkıyorlar ve botla şoförü öldürüyorlar","x":3356,"y":-617,"width":191,"height":146},
		{"id":"49aa557b30aaef03","type":"text","text":"Bot'tan gelmesi gereken saat başı rapor gelmeyince USA bir şeyler ters gidiyor diye anlıyor. Üniversiteye ulaşıyorlar RBA'dan haberiniz var mı diye. Onlardan dedektifi öğreniyorlar ve dedektife gidiyorlar onunla konuşup onu olay yerine getiriyorlar","x":3565,"y":-620,"width":191,"height":146},
		{"id":"a9d4d68057bfdccc","type":"text","text":"USA dedektife ulaşıyor","x":3411,"y":-1068,"width":191,"height":146},
		{"id":"e87221907b371349","type":"text","text":"çatışma oluyor, dedektif ve RBA kaçıyor, asistanla karşılaşıyorlar","x":3915,"y":-617,"width":191,"height":146},
		{"id":"8fb641375380a0c0","type":"text","text":"RBA araştırmayı asistanına veriyoe, asistanı araştırmayı konferansa yolluyor","x":4120,"y":-617,"width":191,"height":146},
		{"id":"0cf4e9e9c289190c","type":"text","text":"Birlikte USA botuna biniyorlar","x":4315,"y":-617,"width":191,"height":146},
		{"id":"484cd8ee4140640b","type":"text","text":"Side Case 2 sırasında bi ara dul kadının oğluna ulaşmak için RBA'nın üniversitesini arıyor","x":2870,"y":-1068,"width":191,"height":146}
	],
