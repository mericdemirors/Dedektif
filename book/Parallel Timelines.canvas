		{"id":"b57fcf69b37913f0","type":"text","text":"Tamirci dolapları tamir etmeye başlıyor","x":-8358,"y":-5405,"width":191,"height":146},
		{"id":"e21dfbcc1ead24dd","type":"text","text":"Kadın bıçağı kendine saplıyor","x":-8358,"y":-5259,"width":191,"height":146},
