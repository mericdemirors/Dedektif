		{"id":"659cb51f49922aa7","type":"text","text":"# DAY28 END","x":2370,"y":-1119,"width":225,"height":85},
		{"id":"31a57e4cf7938ee9","type":"text","text":"Merapi dağını gezip bi plan yapıyor sonraki yer neresi olabilir diye","x":2163,"y":-1594,"width":191,"height":146},
		{"id":"265c5774861c510c","type":"text","text":"Port Moresby'ye dönüyor ve RBA'nın botçusuna denk geliyor, botla Tavurvur'a yola çıkıyorlar","x":2615,"y":-1594,"width":191,"height":146},
		{"id":"d847d4db1542bcdd","type":"text","text":"RBA ve kabile birlikte Tavurvur'da 100 saat, sonra kabile RBA'yı esir alıyor","x":2740,"y":-991,"width":191,"height":146},
		{"id":"5b5e649fdafb241b","type":"text","text":"","x":2931,"y":-779,"width":50,"height":50},
		{"id":"39789d7ebc860371","type":"text","text":"","x":2457,"y":-779,"width":50,"height":50},
		{"id":"47dac1c42f98f3d2","type":"text","text":"Rusya gelip kabileyi öldürüyor, RBA onları oyalamak için bahane üretiyor","x":2981,"y":-991,"width":191,"height":146},
		{"id":"e1c6c0ef4f047818","type":"text","text":"# DAY34 END","x":2965,"y":-1706,"width":225,"height":85},
		{"id":"427ebb7a284ea5af","type":"text","text":"# DAY30 END","x":2467,"y":-1706,"width":225,"height":85},
		{"id":"32b585ca83d0bf63","type":"text","text":"","x":2554,"y":-1380,"width":50,"height":50},
		{"id":"9887de0a585bdc18","type":"text","text":"# DAY31 END","x":2719,"y":-1706,"width":225,"height":85},
		{"id":"693d2413895c3d59","type":"text","text":"","x":2806,"y":-1380,"width":50,"height":50},
		{"id":"4fe0e345be7b4790","type":"text","text":"RBA yürüyerek Tavurvur'a gidiyor ama vadide kabileye yakalanıyor","x":2540,"y":-991,"width":191,"height":146},
		{"id":"4033ab3a62bf547c","type":"text","text":"# DAY34 END","x":2844,"y":-1119,"width":225,"height":85},
		{"id":"49aa557b30aaef03","type":"text","text":"Rusya bot sesini duyup şoförü öldürüyor, asistan son anda suya atlayıp bi şekilde hayatta kalıyor, Bot'tan gelmesi gereken rapor gelmeyince USA bir şeyler ters gidiyor diye anlıyor. Üniversiteye ulaşıyorlar RBA'dan haberiniz var mı diye. Onlardan dedektifi öğreniyorlar ve dedektife gidiyorlar onunla konuşup onu olay yerine getiriyorlar","x":3207,"y":-991,"width":191,"height":146},
		{"id":"a3ff94bea21fdfcc","type":"text","text":"Tavurvur'a gidince ruslar botu duyup bota saldırıyor, asistan hayatta kalıyor, malzemelerini alıp kamp yapmaya gidiyor","x":3128,"y":-1594,"width":191,"height":146},
		{"id":"7501a98c129c6cab","type":"text","text":"Ruslar Merapi etraftaki havaalanlarına rüşvet vererek RBA'nın uçağının nereye gittiğini buluyorlar sonra o tarafa hava gezisi düzenleyip Tavurvur eteklerinde RBA'yı görüyorlar","x":2844,"y":-1594,"width":191,"height":146},
		{"id":"b94cfdc665874035","type":"text","text":"","x":3052,"y":-1380,"width":50,"height":50},
		{"id":"bede35dd5e01cf2b","type":"text","text":"# DAY? END","x":4455,"y":-1135,"width":225,"height":85},
		{"id":"8bbe856d440b81de","type":"text","text":"","x":4542,"y":-795,"width":50,"height":50},
		{"id":"0cf4e9e9c289190c","type":"text","text":"Birlikte USA botuna biniyorlar","x":4316,"y":-991,"width":191,"height":146},
		{"id":"392539739110a48d","type":"text","text":"# DAY35 END","x":3359,"y":-1135,"width":225,"height":85},
		{"id":"51b9325341590620","type":"text","text":"","x":3446,"y":-795,"width":50,"height":50},
		{"id":"e87221907b371349","type":"text","text":"çatışma oluyor, dedektif ve RBA kaçıyor, asistanla karşılaşıyorlar","x":3489,"y":-991,"width":191,"height":146},
		{"id":"8fb641375380a0c0","type":"text","text":"RBA araştırmayı asistanına veriyoe, asistanı araştırmayı konferansa yolluyor","x":3703,"y":-991,"width":191,"height":146},
		{"id":"185fa5039064e94a","type":"text","text":"","x":4156,"y":-795,"width":50,"height":50},
		{"id":"ae24794ccafe9db9","type":"text","text":"# DAY36 END","x":4069,"y":-1135,"width":225,"height":85},
		{"id":"e6c5f9f8d5b6b7d1","type":"text","text":"Buraya biraz daha dedektiflik ekle, dedektifin zeki davrandığı durumlar olsun","x":3926,"y":-991,"width":191,"height":146}
	],
