		{"id":"45f6e11efa3f62a9","type":"group","x":-13006,"y":-572,"width":2620,"height":186,"label":"Side Case 1"},
		{"id":"9e750087e68a0492","type":"text","text":"Dedektif ofisine geri dönüyor ve yazarın temizlikçisini görüyor","x":-2115,"y":1429,"width":191,"height":146},
		{"id":"a4dceff6c54b01a0","type":"text","text":"Yazarın evine gidiyorlar, komodinin oradaki yazıyı buluyor","x":-1909,"y":1429,"width":191,"height":146},
		{"id":"d8e6ba123e261280","type":"text","text":"Yazara zehir testi yapılıyor, olayı çözmek için şeker kabuğuna tamirci cesedine çocuğuna test yapıyor","x":-1700,"y":1429,"width":191,"height":146},
		{"id":"96608df06a150f3d","type":"text","text":"Antifriz olayını çözüyor ve rusun evine gidiyor","x":-1500,"y":1429,"width":191,"height":146},
		{"id":"2fb09be9059d3e2a","type":"text","text":"ricin ölümünü bulmak için doktorla konuşuyorlar","x":-1300,"y":1429,"width":191,"height":146},
		{"id":"60c4b6009fcf1d41","type":"text","text":"ricin ölümü bulunduktan sonra rus ajan göz altına alınıyor","x":-1093,"y":1429,"width":191,"height":146},
		{"id":"4ac6814da16650c9","type":"text","text":"Dedektif rus ajanın evini arayıp diğer zehri falan da buluyor","x":-880,"y":1429,"width":191,"height":146},
		{"id":"9d01584f076771ea","type":"text","text":"Dedektif rus ajanı yakalıyor ve evinde ricin yapma aletleri bulunuyor","x":-1500,"y":403,"width":191,"height":146},
		{"id":"45d57d23091ca009","type":"text","text":"Rus kadının dairesine çıkıyorlar, kadının evini inceliyorlar","x":-2520,"y":1429,"width":191,"height":146},
		{"id":"4acb817e7f3bf3da","type":"text","text":"Rus ajanı sorguya alıyorlar, ve her şeyi itiraf ediyor","x":-635,"y":1881,"width":191,"height":146},
		{"id":"94dfa0803348f9f0","type":"text","text":"Yazar hasta olur, uyuyunca geçer diye uyur","x":-3231,"y":944,"width":191,"height":146},
		{"id":"4d15e416508eb89b","type":"text","text":"Kadın da \"şüpheli sadece rus kadınla araba tamir etti\" diyor","x":-2720,"y":1429,"width":191,"height":146},
		{"id":"b46bdc59051c7609","type":"text","text":"Tekrar tamircinin evine gidip şeker kabuğunu öğreniyorlar","x":-2315,"y":1429,"width":191,"height":146},
		{"id":"1d253433e147a60b","type":"text","text":"Polis tamircinin karısına gidip soru soruyorlar, sonra barları sorguluyorlar","x":-3476,"y":1429,"width":191,"height":146},
		{"id":"b3014fc2ffc7f6e0","type":"text","text":"Bekçi tamirciyi buluyor ve polise haber veriyor","x":-3676,"y":1429,"width":191,"height":146},
		{"id":"e674315c20fa13aa","type":"text","text":"Polis dedektife gidiyor, dedektifle tamircinin karısına gidiyorlar, kocan öldü diyorlar","x":-2920,"y":1429,"width":191,"height":146},
		{"id":"88bea7842dbaa651","type":"text","text":"Polis çözemiyor, doktor da mantıklı bir sebep bulamıyor, sabah dedektife gidelim diyorlar","x":-3276,"y":1429,"width":191,"height":146},
		{"id":"4c04e7857be7923e","type":"text","text":"Uyanınca konuşamadığını ve kollarını oynatamadığını farkeder","x":-2515,"y":940,"width":191,"height":146},
		{"id":"469d0e26c023ada7","type":"text","text":"Kendini yatakta yerde sürüyerek masaya sonrada komodine gider","x":-2315,"y":940,"width":191,"height":146},
		{"id":"9cb79ded368161c4","type":"text","text":"Öğlen temizlikçi kadın ölüsünü buluyor ve dedektife gidiyor","x":-2115,"y":940,"width":191,"height":146},
		{"id":"ffc147ffafcc0e03","type":"text","text":"Olay dedektifin kulağına gitmeyince rus daha yakınlarını öldürmek istiyor","x":-5542,"y":411,"width":191,"height":146},
		{"id":"e0187b17fcffd2c3","type":"text","text":"Doktor tanıyı koyup adamı morga kaldırmış","x":-5856,"y":411,"width":191,"height":146},
		{"id":"5c3267052f3ee128","type":"text","text":"Tamirci önce bara gidiyor, sonra parka gidiyor ve orada ölüyor","x":-3876,"y":1429,"width":191,"height":146},
		{"id":"67c57affbc5ff506","type":"text","text":"Tamirci ve çocuğu eve dönünce karısı adamı evden kovuyor","x":-4076,"y":1429,"width":191,"height":146},
		{"id":"23242e719f56c7e6","type":"text","text":"Rus ajan tamir yardımı için apartman tamircisini çağırıyor","x":-4476,"y":1429,"width":191,"height":146},
		{"id":"e9cbb999ebe2af52","type":"text","text":"Araba tamir olunca limonata ikram ediyor, sonra gidip kusuyor şeker yiyor","x":-4276,"y":1429,"width":191,"height":146},
		{"id":"9a83dc1c195dbe5e","type":"text","text":"# DAYX END","x":-5725,"y":-682,"width":225,"height":85},
		{"id":"ef70c8ae15d81912","type":"text","text":"# DAYX END","x":-5375,"y":-682,"width":225,"height":85},
		{"id":"528e99aa841beaa3","type":"text","text":"Rus ajan evde bakteriden zehri üretir ve yemek yapak, kılık değiştirir","x":-4882,"y":944,"width":191,"height":146},
		{"id":"e8aaa14b24c64236","type":"text","text":"Öğlen yazarın dairesine gider, yemek yerler sonra ayrılır","x":-4667,"y":944,"width":191,"height":146},
		{"id":"0d5e66ff8a5c827a","type":"text","text":"Bekçi bunu ölü bulmuş polisi aramış","x":-6062,"y":411,"width":191,"height":146},
		{"id":"688e602d4d057d4b","type":"text","text":"Eleman kusmaya başlayıp bi yere sızıp ölmüş","x":-6387,"y":411,"width":191,"height":146},
		{"id":"eae952db65f0c59d","type":"text","text":"Rus ajan castor bean'dan zehir üretir","x":-7116,"y":411,"width":191,"height":146},
		{"id":"0611ab06dce107c7","type":"text","text":"","x":-319,"y":-779,"width":50,"height":50},
		{"id":"a395075c134d45dd","type":"text","text":"# DAYX END","x":-6254,"y":-682,"width":225,"height":85},
